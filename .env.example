# =============================================================================
# NemoGuard V22 — Environment Configuration
# Copy to `.env` for standalone/local runs. Never commit real secrets.
# In aXet Flows cloud, the Python Agent injects the aXet LLM values below.
# =============================================================================

# --- Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_SECRET

# --- Environment ---
ENV=development
AXET_FLOWS_AUTH=false

# --- NTT aXet-managed LLM / OpenAI-compatible endpoint ---
# Cloud deployments normally receive these from the aXet Python Agent runtime.
# For standalone/local execution, supply approved values for your environment.
AXET_LLM_BASE_URL=
OPENAI_API_KEY=
AXET_MODEL=
AXET_PROJECT_ID=
AXET_USER_ID=
DEPTAPPS_WEB_BACKEND_JWT_TOKEN=

# --- Database backend ---
# Local Docker/default integration target:
# NEMOGUARD_DB_BACKEND=postgres
# POSTGRES_URL=postgresql://nemoguard:nemoguard_password@localhost:5432/nemoguard_db
# Diagnostic/local-only SQLite:
# NEMOGUARD_DB_BACKEND=sqlite
# NEMOGUARD_SQLITE_PATH=/tmp/nemoguard.db

# --- Workflow orchestration ---
# NEMOGUARD_TEMPORAL_ENABLED=true
# TEMPORAL_URL=localhost:7233

# --- Optional webhook/bridge controls ---
NEMOGUARD_WEBHOOK_SECRET=
NEMOGUARD_WEBHOOK_AUTO_RESOLVE=false
