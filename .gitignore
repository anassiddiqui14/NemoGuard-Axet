# Environments
.env
.env.*
!.env.example
!.env.test

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env/
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# The bare `lib/` pattern above is intended only for Python virtualenv
# internals (e.g. venv/lib/), but as an unanchored pattern it also
# matches renderer/src/lib/ -- a genuine frontend source directory
# (TypeScript helper modules). Explicitly un-ignore it rather than
# weakening/removing the venv pattern itself.
!renderer/src/lib/
!renderer/src/lib/**

# SQLite databases (generated data)
data/generated/*.db
data/generated/*.sqlite
data/generated/*.sqlite3

# Logs and temp files
*.log
logs/
ssh.log
tunnel.log
connect.log
cloudflared.log

# Cloudflared binaries
cloudflared

# PEM / cert files
*.pem
cert.pem
key.pem

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Misc
.pytest_cache/
htmlcov/
.coverage
.tox/
.nox/

# Editor/session artifacts
.pi_session/
data/.pi_session/

# Masked real-world alert imports (derived from real org data — never commit,
# even though masked; see scripts/import_real_alerts.py)
data/imported_alerts/

# Pyc cache dirs
__pycache__/
**/__pycache__/

# Node dependencies (root safety net)
node_modules/
**/node_modules/
dist/
**/dist/
localstack_lab/_build/
